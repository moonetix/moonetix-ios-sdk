# Server only. Never put these values in the app.
# API key from the API page of your Moonetix dashboard.
MOONETIX_API_KEY=your_api_key_here
# Demo sign-in for local tests only: token=userId pairs. Replace with your own sign-in.
DEMO_SESSIONS=dev-session-1=user_1234
PORT=3000
# Postback secret key from the Postback page, used by your postback handler.
MOONETIX_POSTBACK_KEY=test_postback_key_not_secret
